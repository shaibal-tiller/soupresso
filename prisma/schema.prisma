// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Chart of accounts
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  type         AccountType
  // true for accounts the posting engine depends on (Cash, Bank, AP, AR, Sales Income...).
  // Prevents accidental deletion from the Chart of Accounts UI.
  isSystem     Boolean     @default(false)
  // true for liquid cash/bank/mobile-banking accounts the user can pay from or deposit to.
  // Drives the fund-source picker on Entries, Daily Sales, and the Cash & Bank page.
  isFundSource Boolean     @default(false)
  isActive     Boolean     @default(true)
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  journalLines      JournalLine[]
  partner           Partner?
  fundSourceEntries Entry[]            @relation("EntryFundSource")
  transferToEntries Entry[]            @relation("EntryTransferTo")
  dailySaleFundings DailySaleFunding[]

  @@index([type])
  @@index([isFundSource])
}

// ---------------------------------------------------------------------------
// Partners (the 15 co-owners)
// ---------------------------------------------------------------------------

model Partner {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  sharePercent Decimal? @db.Decimal(6, 3)
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Every partner gets a dedicated Equity account, e.g. "Owner's Equity - Rahim".
  equityAccountId String  @unique
  equityAccount   Account @relation(fields: [equityAccountId], references: [id])

  entries Entry[]
}

// ---------------------------------------------------------------------------
// Menu (customizable, used only for approximate item-level sales analytics)
// ---------------------------------------------------------------------------

enum MenuCategory {
  SOUP
  MAIN
  SNACK
  DRINK
  OTHER
}

model MenuItem {
  id           String       @id @default(cuid())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  parcelPrice  Decimal?     @db.Decimal(10, 2)
  category     MenuCategory @default(OTHER)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  costEstimate Decimal?     @db.Decimal(10, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  saleItems DailySaleItem[]
}

// ---------------------------------------------------------------------------
// Ledger core: Entry (user-facing, single record) + JournalLine (double entry)
// ---------------------------------------------------------------------------

enum EntryCategory {
  INVESTMENT
  ASSET_PURCHASE
  RAW_MATERIAL
  PACKAGING_SUPPLIES
  CHEF_SALARY
  STAFF_WELFARE // staff meals, allowances — separate from base salary
  RENT
  UTILITY
  CLEANING_MAINTENANCE
  OTHER_EXPENSE
  SALES
  LOAN_RECEIVED
  LOAN_REPAYMENT
  PAYABLE_SETTLEMENT
  RECEIVABLE_COLLECTION
  WITHDRAWAL
  ADJUSTMENT
  BALANCE_ADJUSTMENT // sets/corrects an account's balance (e.g. opening balance) against the Balance Adjustments equity account
  TRANSFER // moves money between two fund source accounts (e.g. cash deposited to bank)
}

enum PaymentMethod {
  FUND_SOURCE // paid from / deposited to a specific cash, bank, or mobile-banking account
  CREDIT // unpaid: Accounts Payable (expense/asset side) or Accounts Receivable (sales side)
  MIXED // split across multiple fund source accounts, used by daily sales close-out
}

model Entry {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  category      EntryCategory
  description   String
  vendor        String?
  quantity      Decimal?      @db.Decimal(10, 2)
  unit          String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  // The account this entry primarily concerns: paid-from/deposited-to for FUND_SOURCE entries,
  // the "from" side of a TRANSFER, or the account being corrected for BALANCE_ADJUSTMENT.
  fundSourceAccountId String?
  fundSourceAccount   Account? @relation("EntryFundSource", fields: [fundSourceAccountId], references: [id])
  // Only set for TRANSFER entries: the "to" account receiving the funds.
  transferToAccountId String?
  transferToAccount   Account? @relation("EntryTransferTo", fields: [transferToAccountId], references: [id])

  dailySale DailySale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[]

  @@index([date])
  @@index([category])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  entry     Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Decimal @default(0) @db.Decimal(12, 2)
  credit    Decimal @default(0) @db.Decimal(12, 2)

  @@index([accountId])
  @@index([entryId])
}

// ---------------------------------------------------------------------------
// Daily sales (end-of-day close-out)
// ---------------------------------------------------------------------------

model DailySale {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  totalAmount Decimal  @db.Decimal(12, 2)
  notes       String?

  entryId String @unique
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  items    DailySaleItem[]
  fundings DailySaleFunding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-fund-source split of a day's sales (cash, bank, bKash, Nagad, ...).
model DailySaleFunding {
  id                  String    @id @default(cuid())
  dailySaleId         String
  dailySale           DailySale @relation(fields: [dailySaleId], references: [id], onDelete: Cascade)
  fundSourceAccountId String
  fundSourceAccount   Account   @relation(fields: [fundSourceAccountId], references: [id])
  amount              Decimal   @db.Decimal(12, 2)

  @@index([dailySaleId])
  @@index([fundSourceAccountId])
}

model DailySaleItem {
  id          String    @id @default(cuid())
  dailySaleId String
  dailySale   DailySale @relation(fields: [dailySaleId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity    Int
  isParcel    Boolean   @default(false)
  unitPrice   Decimal   @db.Decimal(10, 2)
  lineTotal   Decimal   @db.Decimal(10, 2)

  @@index([dailySaleId])
  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Common purchase items — a tappable shortlist so buying chicken, onions,
// packaging etc. daily doesn't mean retyping the description every time.
// Purely a UI convenience; the resulting Entry rows are ordinary expenses.
// ---------------------------------------------------------------------------

model PurchaseItem {
  id        String        @id @default(cuid())
  name      String
  category  EntryCategory
  unit      String?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Audit log — a permanent, append-only record of every financial action.
// Rows are never updated or deleted, including when the record they describe
// (e.g. an Entry) is later deleted, so the trail survives the data.
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  occurredAt DateTime    @default(now())
  actor      String // self-reported name of whoever performed the action
  action     AuditAction
  entityType String // "Entry", "DailySale", "Account", "Partner", "MenuItem"
  entityId   String
  summary    String // human-readable one-liner, e.g. "Raw Material ৳1,500 from Cash in Hand"
  amount     Decimal?    @db.Decimal(12, 2)
  detail     Json? // full snapshot of the record at the time of the action

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([action])
}
