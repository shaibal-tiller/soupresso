# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables instead —
# never commit real secrets to a file that goes into git.

# Postgres connection string (Vercel Postgres, Neon, Supabase, or any Postgres host)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "false" only for a local Postgres that doesn't use SSL.
DATABASE_SSL=false

# The single login used by the person(s) operating this cash register.
APP_EMAIL=owner@example.com
APP_PASSWORD=change-this-password

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
